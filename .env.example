POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=change-me

JWT_ISSUER=ECommercePlatform
JWT_AUDIENCE=ECommercePlatform.Clients
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-at-least-32-characters

RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me

PAYMENT_POSTGRES_DB=payment
PAYMENT_POSTGRES_USER=payment_user
PAYMENT_POSTGRES_PASSWORD=change-me

# frontend/Dockerfile build args — same values as frontend/.env.example (browser-facing, so they
# stay host-published localhost URLs even when frontend runs in Docker; see docker-compose.yml's
# frontend.environment.INTERNAL_API_URL for the SSR-only counterpart).
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_PAYMENT_API_URL=http://localhost:8081/api
